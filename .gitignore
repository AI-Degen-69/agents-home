# Loop throwaway files — the self-improve-loop writes these at runtime;
# committing them would record stale intent the moment the remote moves.
loop-delivery.json
SHARED_TASK_NOTES.md

# Skill housekeeping metadata — non-canonical descriptions for linked skills,
# kept out of the canonical tree by policy (see skills/README.md).
skills/*/DESCRIPTION.md

# Harness transient state and OS junk — never canonical (per docs/issue-to-pr-skill-workflow.md artifact homes)
.freebuff/
.playwright-cli/
desktop.ini
icon_*.ico

# Language artifacts — this repo tracks Python scripts under skills/ (e.g.
# skills/skill-creator/scripts/, skills/skill-refinement-loop/scripts/), so
# importing one compiles its siblings into __pycache__/ and shows up as
# untracked dirt in `git status --porcelain` — the Clean Exit Gate check.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Node artifacts — parity/future-proofing; nothing generates these yet.
node_modules/
