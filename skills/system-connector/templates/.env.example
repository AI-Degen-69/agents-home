# <SYSTEM> connector credentials
# This file stays on your computer. The assistant never reads it;
# the helper script reads it locally when it makes API calls.
# Fill in the values below, save, then tell the assistant "done".
#
# Only the values required for the default connection belong here.
# Optional auth modes, output formats, SSL flags, scopes, tenant IDs,
# and advanced settings stay out of this file unless the connection
# cannot work without them.

# Root URL of the <SYSTEM> API.
# Where to find it: <specific admin screen, docs page, or admin role>
BASE_URL=https://api.example.com

# API token.
# Where to find it: <specific token screen, docs page, or admin role>
API_TOKEN=paste-your-token-here
